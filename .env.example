# ==============================================================================
# NAS & Raspberry Pi Remote Control Panel - Configuration Template
# ==============================================================================

# --- Application Server & Security ---
PORT=3000
NODE_ENV=production
# Required: Strong random secret for signing session cookies (min 32 characters)
APP_AUTH_SECRET=change-this-to-a-very-strong-random-secret-key-32-chars
# Required: Dashboard access password
APP_PASSWORD=admin-password-change-me
# Optional: Cookie secure flag ('auto', 'true', 'false'). Default: 'auto' (false on HTTP / LAN IP, true on HTTPS)
COOKIE_SECURE=auto

# --- Synology NAS Configuration ---
# Primary Host: Tailscale IP or primary address (e.g. 100.x.x.x)
NAS_HOST=100.x.x.x
# Fallback / Local Host: Used when Tailscale is inactive (e.g. 192.168.1.204)
# Note: URLs like smb://192.168.1.204 or http://192.168.1.204 are automatically cleaned
NAS_FALLBACK_HOST=192.168.1.204
# Synology DSM WebAPI HTTPS Port (default 5001)
NAS_PORT=5001
# DSM user with permissions to check status and shut down/reboot the NAS
NAS_USERNAME=nas_admin
NAS_PASSWORD=nas_admin_password
# MAC address of the Synology NAS for Wake-on-LAN (e.g. 00:11:32:AA:BB:CC)
NAS_WOL_MAC=00:11:32:00:00:00
# Wake-on-LAN Broadcast Address (default: 255.255.255.255, or subnet e.g. 192.168.1.255)
NAS_WOL_BROADCAST_ADDRESS=255.255.255.255
# Wake-on-LAN UDP Port (default: 9)
NAS_WOL_PORT=9
# Set to 'false' if using self-signed DSM certificates or internal Tailscale certs
NAS_REJECT_UNAUTHORIZED=false
# Optional QuickConnect ID (e.g. avum -> generates http://quickconnect.to/avum)
NAS_QUICKCONNECT_ID=avum
# Optional Custom / Direct DSM Web Management URL (overrides default host/QuickConnect if set)
# e.g. https://192-168-1-205.avum.direct.quickconnect.to:5001/#/signin or http://quickconnect.to/avum
NAS_WEB_URL=

# --- Raspberry Pi & Docker Configuration ---
# Path to the host Docker daemon Unix socket
DOCKER_SOCKET_PATH=/var/run/docker.sock
